{
  "name": "domain-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "worker": "node --env-file=.env --import tsx src/worker.ts",
    "db:generate": "prisma generate",
